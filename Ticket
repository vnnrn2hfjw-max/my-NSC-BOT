const {
    SlashCommandBuilder,
    EmbedBuilder,
    ActionRowBuilder,
    StringSelectMenuBuilder
} = require("discord.js");

module.exports = {

data: new SlashCommandBuilder()
.setName("ticket")
.setDescription("Send the ticket panel"),

async execute(interaction) {

const embed = new EmbedBuilder()
.setColor("#8B0000")
.setTitle("🔴⚫ NSC Ticket Center")
.setDescription(
`Welcome to the **NSC Ticket System**

Choose the ticket type you need below.

🛒 **Buyer Ticket**
Purchase items or services.

💬 **Support Ticket**
Need help from staff?

🎁 **Free Access Ticket**
Request free access.

━━━━━━━━━━━━━━
⚫ Do not abuse the ticket system.
🔴 Staff will assist you shortly.`
)
.setFooter({
text:"NSC • No Second Chances"
});


const menu = new StringSelectMenuBuilder()
.setCustomId("ticket_menu")
.setPlaceholder("🔴 Select ticket type")
.addOptions([
{
label:"Buyer Ticket",
description:"Purchase something",
value:"buyer",
emoji:"🛒"
},
{
label:"Support Ticket",
description:"Get help",
value:"support",
emoji:"💬"
},
{
label:"Free Access Ticket",
description:"Request access",
value:"free",
emoji:"🎁"
}
]);


const row = new ActionRowBuilder()
.addComponents(menu);


await interaction.reply({
embeds:[embed],
components:[row]
});

}

};
